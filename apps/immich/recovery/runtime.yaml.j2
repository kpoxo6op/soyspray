apiVersion: v1
kind: Pod
metadata:
  name: redis
  namespace: {{ recovery_namespace }}
  labels:
    soyspray.vip/purpose: immich-restore-check
    soyspray.vip/app: immich
    soyspray.vip/check-id: {{ recovery_check_id }}
    app: immich-recovery-redis
spec:
  automountServiceAccountToken: false
  restartPolicy: Always
  containers:
    - name: redis
      image: {{ recovery_redis_image }}
      env: [{name: ALLOW_EMPTY_PASSWORD, value: 'yes'}]
      ports: [{name: redis, containerPort: 6379}]
---
apiVersion: v1
kind: Service
metadata:
  name: redis
  namespace: {{ recovery_namespace }}
  labels: {{ recovery_labels | to_json }}
spec:
  type: ClusterIP
  selector: {app: immich-recovery-redis}
  ports: [{name: redis, port: 6379, targetPort: redis}]
---
apiVersion: v1
kind: Pod
metadata:
  name: immich-server
  namespace: {{ recovery_namespace }}
  labels:
    soyspray.vip/purpose: immich-restore-check
    soyspray.vip/app: immich
    soyspray.vip/check-id: {{ recovery_check_id }}
    app: immich-recovery-server
spec:
  automountServiceAccountToken: false
  restartPolicy: Always
  containers:
    - name: immich-server
      image: {{ recovery_server_image_digest }}
      env:
        - {name: DB_URL, valueFrom: {secretKeyRef: {name: immich-app-config, key: DB_URL}}}
        - {name: DB_VECTOR_EXTENSION, value: pgvecto.rs}
        - {name: REDIS_HOSTNAME, value: redis}
        - {name: REDIS_PORT, value: '6379'}
        - {name: IMMICH_MACHINE_LEARNING_URL, value: ''}
        - {name: IMMICH_HOST, value: 0.0.0.0}
        - {name: IMMICH_PORT, value: '2283'}
      ports: [{name: http, containerPort: 2283}]
      readinessProbe:
        httpGet: {path: /api/server/ping, port: http}
        initialDelaySeconds: 20
        periodSeconds: 10
      volumeMounts:
        - {name: restored-data, mountPath: /usr/src/app/upload, subPath: usr/src/app/upload}
  volumes:
    - name: restored-data
      persistentVolumeClaim: {claimName: restored-data}
---
apiVersion: v1
kind: Service
metadata:
  name: immich-server
  namespace: {{ recovery_namespace }}
  labels: {{ recovery_labels | to_json }}
spec:
  type: ClusterIP
  selector: {app: immich-recovery-server}
  ports: [{name: http, port: 2283, targetPort: http}]
