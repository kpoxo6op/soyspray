apiVersion: batch/v1
kind: Job
metadata:
  name: database-restore
  namespace: {{ recovery_namespace }}
  labels: {{ recovery_labels | to_json }}
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 7200
  template:
    metadata:
      labels:
        soyspray.vip/purpose: immich-restore-check
        soyspray.vip/app: immich
        soyspray.vip/check-id: {{ recovery_check_id }}
        soyspray.vip/component: database-restore
    spec:
      automountServiceAccountToken: false
      restartPolicy: Never
      containers:
        - name: postgres
          image: {{ recovery_database_image }}
          command: [/bin/sh, -ec]
          args:
            - >-
              export PGPASSWORD="$(cat /run/secrets/db-password/password)";
              pg_restore --exit-on-error --no-owner --no-acl --clean --if-exists
              --host immich-db-restore-rw --port 5432 --username {{ recovery_db_username }}
              --dbname immich /restore/backup/database/immich.dump;
              counts="$(psql --host immich-db-restore-rw --port 5432 --username {{ recovery_db_username }} --dbname immich --tuples-only --no-align --command
              'SELECT (SELECT count(*) FROM asset) || chr(44) || (SELECT count(*) FROM album) || chr(44) || (SELECT count(*) FROM public."user");')";
              test "$counts" = "{{ recovery_expected_asset_count }},{{ recovery_expected_album_count }},{{ recovery_expected_user_count }}";
              printf 'database_counts=%s\n' "$counts"
          volumeMounts:
            - {name: restored-data, mountPath: /restore, readOnly: true}
            - {name: db-password, mountPath: /run/secrets/db-password, readOnly: true}
          env:
            - {name: PGUSER, value: {{ recovery_db_username | quote }}}
      volumes:
        - name: restored-data
          persistentVolumeClaim: {claimName: restored-data}
        - name: db-password
          secret:
            secretName: immich-db-credentials
            items: [{key: password, path: password}]
