apiVersion: batch/v1
kind: Job
metadata:
  name: app-health
  namespace: {{ recovery_namespace }}
  labels: {{ recovery_labels | to_json }}
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 300
  template:
    metadata:
      labels:
        soyspray.vip/purpose: immich-restore-check
        soyspray.vip/app: immich
        soyspray.vip/check-id: {{ recovery_check_id }}
        soyspray.vip/component: app-health
    spec:
      automountServiceAccountToken: false
      restartPolicy: Never
      containers:
        - name: curl
          image: {{ recovery_probe_image }}
          command: [/bin/sh, -ec]
          args:
            - >-
              curl --fail --silent --show-error http://immich-server:2283/api/server/ping |
              grep -F '"res":"pong"';
              curl --fail --silent --show-error http://immich-server:2283/api/server/version
