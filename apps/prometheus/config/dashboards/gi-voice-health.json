{
  "uid": "gi-voice-health",
  "title": "GI voice health",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "soyspray",
    "voice"
  ],
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "Pacific/Auckland",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Listening should be active",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(voice_listen_expected{job=\"voice-health\"})",
          "legendFormat": "Listening should be active"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Paused"
                },
                "1": {
                  "text": "Waiting for GI"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Current diagnostics available",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(voice_diagnostics_ready{job=\"voice-health\"})",
          "legendFormat": "Current diagnostics available"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unavailable"
                },
                "1": {
                  "text": "Available"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Traffic reaching the GI wake service",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "voice:gi_ingress_bytes_per_second",
          "legendFormat": "Traffic reaching the GI wake service"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Microphone callback age",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(voice_microphone_frame_age_seconds{job=\"voice-health\"})",
          "legendFormat": "Microphone callback age"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Device reported phase",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(voice_stage{job=\"voice-health\"})",
          "legendFormat": "Device reported phase"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Waiting for GI"
                },
                "2": {
                  "text": "Waiting for command"
                },
                "3": {
                  "text": "Receiving command"
                },
                "4": {
                  "text": "Processing"
                },
                "5": {
                  "text": "Speaking"
                },
                "10": {
                  "text": "Disconnected"
                },
                "11": {
                  "text": "Error"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Last recovery reason",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(voice_recovery_reason{job=\"voice-health\"})",
          "legendFormat": "Last recovery reason"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "None"
                },
                "1": {
                  "text": "Listening stopped"
                },
                "2": {
                  "text": "Run not acknowledged"
                },
                "3": {
                  "text": "Microphone stale"
                },
                "4": {
                  "text": "Stop did not finish"
                },
                "5": {
                  "text": "Interaction stalled"
                },
                "6": {
                  "text": "Manual recovery"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Recovery attempts",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(voice_recovery_count{job=\"voice-health\"})",
          "legendFormat": "Recovery attempts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Automatic reboots used (limit 3)",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(voice_reboot_budget_used{job=\"voice-health\"})",
          "legendFormat": "Automatic reboots used (limit 3)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Home Assistant acknowledged this run",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(voice_pipeline_acknowledged{job=\"voice-health\"})",
          "legendFormat": "Home Assistant acknowledged this run"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Awaiting acknowledgement"
                },
                "1": {
                  "text": "Acknowledged"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Device uptime",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(voice_uptime_seconds{job=\"voice-health\"})",
          "legendFormat": "Device uptime"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "type": "text",
      "title": "Reading a failure",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "Expected listening with little GI traffic means the voice path is stalled. Fresh microphone callbacks with no GI traffic place the failure after microphone capture; old callbacks point to the device. Use **Recover GI listening** in Home Assistant once and check traffic again. Recovery exhaustion stops automatic reboot attempts. These counters record transport and recovery, without audio or transcripts; they cannot prove wake accuracy, speech recognition or a completed command."
      }
    }
  ]
}
