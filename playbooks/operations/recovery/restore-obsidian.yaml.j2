apiVersion: v1
kind: Secret
metadata:
  name: couchdb
  namespace: {{ recovery_scratch }}
data: {{ recovery_couchdb_secret[0].data | to_json }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: couchdb
  namespace: {{ recovery_scratch }}
data: {{ recovery_couchdb_config[0].data | to_json }}
---
apiVersion: v1
kind: Pod
metadata:
  name: app
  namespace: {{ recovery_scratch }}
  labels:
    soyspray.vip/purpose: restore-check
spec:
  nodeName: {{ recovery_workspace.results[0].resources[0].spec.nodeName }}
  automountServiceAccountToken: false
  enableServiceLinks: false
  restartPolicy: Never
  activeDeadlineSeconds: 14400
  securityContext:
    runAsNonRoot: true
    runAsUser: 5984
    runAsGroup: 5984
    fsGroup: 5984
    seccompProfile: {type: RuntimeDefault}
  initContainers:
    - name: config
      image: {{ recovery_couchdb_image | to_json }}
      command: [sh, -ec, 'cp /input/* /config/']
      securityContext:
        allowPrivilegeEscalation: false
        capabilities: {drop: [ALL]}
      resources:
        requests: {cpu: 10m, memory: 32Mi}
        limits: {cpu: 250m, memory: 64Mi}
      volumeMounts:
        - {name: config-input, mountPath: /input, readOnly: true}
        - {name: config, mountPath: /config}
  containers:
    - name: app
      image: {{ recovery_couchdb_image | to_json }}
      env:
        - name: COUCHDB_USER
          valueFrom:
            secretKeyRef: {name: couchdb, key: adminUsername}
        - name: COUCHDB_PASSWORD
          valueFrom:
            secretKeyRef: {name: couchdb, key: adminPassword}
        - name: COUCHDB_SECRET
          valueFrom:
            secretKeyRef: {name: couchdb, key: cookieAuthSecret}
        - name: COUCHDB_ERLANG_COOKIE
          valueFrom:
            secretKeyRef: {name: couchdb, key: erlangCookie}
        - {name: ERL_FLAGS, value: ' -name couchdb@127.0.0.1 '}
      readinessProbe:
        httpGet: {path: /, port: 5984}
      securityContext:
        allowPrivilegeEscalation: false
        capabilities: {drop: [ALL]}
      resources:
        requests: {cpu: 25m, memory: 128Mi}
        limits: {cpu: 1000m, memory: 512Mi}
      volumeMounts:
        - {name: data, mountPath: /opt/couchdb/data}
        - {name: config, mountPath: /opt/couchdb/etc/default.d}
  volumes:
    - name: data
      persistentVolumeClaim: {claimName: restored-data}
    - name: config
      emptyDir: {}
    - name: config-input
      configMap:
        name: couchdb
        items:
          - {key: inifile, path: chart.ini}
          - {key: seedlistinifile, path: seedlist.ini}
