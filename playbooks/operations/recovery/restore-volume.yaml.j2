apiVersion: v1
kind: Namespace
metadata:
  name: {{ recovery_scratch }}
  labels: {{ recovery_labels | to_json }}
  annotations:
    soyspray.vip/backup-uid: {{ recovery_backup.resources[0].metadata.uid }}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: isolate
  namespace: {{ recovery_scratch }}
  labels: {{ recovery_labels | to_json }}
spec:
  podSelector: {}
  policyTypes: [Ingress, Egress]
  ingress: []
  egress: []
---
apiVersion: storage.k8s.io/v1
kind: StorageClass
metadata:
  name: {{ recovery_scratch }}
  labels: {{ recovery_labels | to_json }}
  annotations:
    soyspray.vip/backup-uid: {{ recovery_backup.resources[0].metadata.uid }}
provisioner: driver.longhorn.io
allowVolumeExpansion: false
reclaimPolicy: Delete
volumeBindingMode: Immediate
parameters:
  fromBackup: {{ recovery_backup.resources[0].status.url | to_json }}
  backupTargetName: critical-s3
  dataEngine: v1
  fsType: ext4
  numberOfReplicas: "1"
  recurringJobSelector: "[]"
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: restored-data
  namespace: {{ recovery_scratch }}
  labels: {{ recovery_labels | to_json }}
spec:
  accessModes: [ReadWriteOnce]
  volumeMode: Filesystem
  storageClassName: {{ recovery_scratch }}
  resources:
    requests:
      storage: {{ recovery_backup.resources[0].status.volumeSize | to_json }}
