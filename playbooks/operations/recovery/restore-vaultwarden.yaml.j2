apiVersion: v1
kind: Pod
metadata:
  name: app
  namespace: {{ recovery_scratch }}
  labels:
    soyspray.vip/purpose: restore-check
spec:
  nodeName: {{ recovery_workspace.results[0].resources[0].spec.nodeName }}
  automountServiceAccountToken: false
  enableServiceLinks: false
  restartPolicy: Never
  activeDeadlineSeconds: 14400
  securityContext:
    runAsNonRoot: true
    runAsUser: 1000
    runAsGroup: 1000
    fsGroup: 1000
    seccompProfile: {type: RuntimeDefault}
  containers:
    - name: app
      image: ghcr.io/dani-garcia/vaultwarden:testing@sha256:93a29083d81bab3b29a34252662cd50d8191eeb248e2d9f9573ba455b4367934
      env:
        - {name: DOMAIN, value: 'http://127.0.0.1:18080'}
        - {name: ROCKET_ADDRESS, value: '0.0.0.0'}
        - {name: ROCKET_PORT, value: '8080'}
        - {name: SIGNUPS_ALLOWED, value: 'false'}
        - {name: INVITATIONS_ALLOWED, value: 'false'}
        - {name: PUSH_ENABLED, value: 'false'}
      readinessProbe:
        httpGet: {path: /alive, port: 8080}
      securityContext:
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities: {drop: [ALL]}
      resources:
        requests: {cpu: 25m, memory: 64Mi}
        limits: {cpu: 500m, memory: 256Mi}
      volumeMounts:
        - {name: data, mountPath: /data}
        - {name: tmp, mountPath: /tmp}
  volumes:
    - name: data
      persistentVolumeClaim: {claimName: restored-data}
    - name: tmp
      emptyDir: {}
