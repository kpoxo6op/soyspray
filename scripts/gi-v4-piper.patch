+def load_planned_model(*, model_path: Path, config_path: Path):
+    """Load one pinned renderer for deterministic planned batches."""
+    with config_path.open("r", encoding="utf-8") as config_file:
+        config = json.load(config_file)
+    model = torch.load(model_path, weights_only=False)
+    model.eval()
+    if torch.cuda.is_available():
+        model.cuda()
+    resampler = torchaudio.transforms.Resample(
+        config["audio"]["sample_rate"],
+        16000,
+        lowpass_filter_width=64,
+        rolloff=0.9475937167399596,
+        resampling_method="sinc_interp_kaiser",
+        beta=14.769656459379492,
+    )
+    return {"model": model, "config": config, "resampler": resampler}
+
+
+def generate_planned_batch(
+    renderer,
+    *,
+    texts,
+    speaker_pairs,
+    slerp_weight,
+    length_scale,
+    noise_scale,
+    noise_scale_w,
+    duration_noise_seeds,
+    latent_noise_seeds,
+):
+    """Return one 16 kHz mono PCM16 byte buffer for each planned row."""
+    lengths = {
+        len(texts),
+        len(speaker_pairs),
+        len(duration_noise_seeds),
+        len(latent_noise_seeds),
+    }
+    if lengths == {0} or len(lengths) != 1:
+        raise ValueError("Planned Piper batch fields must have one non-zero length")
+    config = renderer["config"]
+    voice = config["espeak"]["voice"]
+    phoneme_ids = [get_phonemes(voice, config, text)[0] for text in texts]
+    phoneme_lengths = [len(ids) for ids in phoneme_ids]
+    maximum = max(phoneme_lengths)
+    phoneme_ids = [ids + [1] * (maximum - len(ids)) for ids in phoneme_ids]
+    speaker_1 = torch.LongTensor([pair[0] for pair in speaker_pairs])
+    speaker_2 = torch.LongTensor([pair[1] for pair in speaker_pairs])
+    with torch.no_grad():
+        audio, phoneme_samples = generate_audio(
+            renderer["model"],
+            speaker_1,
+            speaker_2,
+            phoneme_ids,
+            slerp_weight,
+            noise_scale,
+            noise_scale_w,
+            length_scale,
+            None,
+            phoneme_lengths=phoneme_lengths,
+            duration_noise_seeds=duration_noise_seeds,
+            latent_noise_seeds=latent_noise_seeds,
+        )
+    for index in range(audio.shape[0]):
+        last_sample = int(phoneme_samples[index].flatten().sum().item())
+        audio[index, 0, last_sample + 1 :] = 0
+    audio = renderer["resampler"](audio.cpu()).numpy()
+    return [
+        remove_silence(audio_float_to_int16(audio[index]).flatten())
+        .astype(np.int16)
+        .tobytes()
+        for index in range(audio.shape[0])
+    ]
+
