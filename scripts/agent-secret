#!/usr/bin/env python3
"""Keep the installed restricted-reader command at its existing path."""

import runpy
from pathlib import Path

_reader = runpy.run_path(
    str(Path(__file__).resolve().parents[1] / "apps/vaultwarden/agent_secret.py")
)
read_hays_item = _reader["read_hays_item"]

if __name__ == "__main__":
    raise SystemExit(_reader["main"]())
